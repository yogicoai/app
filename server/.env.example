# 서버 포트
PORT=4000
NODE_ENV=development

# MongoDB Atlas 연결 문자열 (Atlas 대시보드 > Connect > Drivers 에서 복사)
# 끝의 /gongmuwon9 가 DB 이름. 비밀번호에 특수문자 있으면 URL 인코딩 필요.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gongmuwon9?retryWrites=true&w=majority

# JWT 서명 키 — 최소 16자 이상의 랜덤 문자열로 교체할 것
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-min-16-chars

# CORS 허용 오리진 (개발은 *, 운영은 앱 도메인 콤마구분)
CORS_ORIGIN=*
