{
  "name": "gongmuwon9-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "9급 공무원 시험대비 앱 백엔드 (Fastify + MongoDB)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "import": "tsx src/scripts/import-content.ts",
    "daily": "tsx src/scripts/build-daily-set.ts",
    "tag": "tsx src/scripts/tag-questions.ts",
    "import:pdf": "tsx src/scripts/import-pdf.ts",
    "fix": "tsx src/scripts/fix-questions.ts",
    "migrate:passage": "tsx src/scripts/split-passage.ts",
    "setup": "npm run seed && npm run import && npm run daily",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "mongoose": "^8.8.0",
    "nodemon": "^3.1.14",
    "openai": "^4.104.0",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
